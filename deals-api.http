### Environment Variables
@baseUrl = http://localhost:3000
@authToken = YOUR_JWT_ACCESS_TOKEN_HERE
@dealId = 67104b281f9a2b3c4d5e6f7a
@companyId = 670f5d0a1b2c3d4e5f6a7b8c
@contactId = 670f5d0a1b2c3d4e5f6a7b8d
@ownerId = 670f5d0a1b2c3d4e5f6a7b8e
@noteId = 67104b281f9a2b3c4d5e6f99
@activityId = 67104b281f9a2b3c4d5e6f88

### 1. Create a New Deal Opportunity (All Fields)
POST {{baseUrl}}/deals
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Enterprise Cloud Infrastructure Modernization",
  "description": "Multi-year hybrid cloud transition and database re-platforming contract.",
  "pipeline": "STANDARD",
  "stage": "NEW",
  "amount": 150000,
  "currency": "USD",
  "probability": 20,
  "expectedCloseDate": "2026-12-31T18:30:00.000Z",
  "companyId": "{{companyId}}",
  "contactId": "{{contactId}}",
  "ownerId": "{{ownerId}}",
  "products": [
    {
      "name": "Cloud Platform Enterprise Seats",
      "sku": "SKU-CLD-ENT-01",
      "quantity": 2,
      "unitPrice": 50000,
      "discount": 10,
      "description": "Enterprise tier licensing with 10% volume discount"
    },
    {
      "name": "Dedicated Solution Architect Support",
      "sku": "SKU-SRV-ARCH-01",
      "quantity": 1,
      "unitPrice": 60000,
      "discount": 0,
      "description": "6 months dedicated cloud architecture advisory"
    }
  ],
  "tags": [
    "enterprise",
    "cloud-migration",
    "q4-target",
    "strategic"
  ],
  "priority": "HIGH"
}

### 2. List Deals (All Query Filters)
GET {{baseUrl}}/deals?page=1&limit=20&sort=amount&order=desc&search=Modernization&pipeline=STANDARD&stage=NEW&status=OPEN&currency=USD&priority=HIGH&tag=enterprise&minAmount=10000&maxAmount=500000
Authorization: Bearer {{authToken}}

### 3. Get Pipeline Kanban Columns
GET {{baseUrl}}/deals/pipeline?pipeline=STANDARD
Authorization: Bearer {{authToken}}

### 4. Get Revenue Forecast (All Query Parameters)
GET {{baseUrl}}/deals/forecast?currency=USD&pipeline=STANDARD&startDate=2026-01-01&endDate=2026-12-31
Authorization: Bearer {{authToken}}

### 5. Export Deals
GET {{baseUrl}}/deals/export?pipeline=STANDARD&stage=NEW&status=OPEN&currency=USD
Authorization: Bearer {{authToken}}

### 6. Bulk Assign Multiple Deals
POST {{baseUrl}}/deals/bulk-assign
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "dealIds": [
    "{{dealId}}"
  ],
  "ownerId": "{{ownerId}}"
}

### 7. Get Deal by ID
GET {{baseUrl}}/deals/{{dealId}}
Authorization: Bearer {{authToken}}

### 8. Update Deal (All Editable Fields)
PATCH {{baseUrl}}/deals/{{dealId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Enterprise Cloud Infrastructure Modernization (Phase 1 & 2)",
  "description": "Expanded scope to include Disaster Recovery site replication.",
  "pipeline": "STANDARD",
  "stage": "QUALIFIED",
  "amount": 180000,
  "currency": "USD",
  "probability": 25,
  "expectedCloseDate": "2027-03-31T18:30:00.000Z",
  "companyId": "{{companyId}}",
  "contactId": "{{contactId}}",
  "ownerId": "{{ownerId}}",
  "products": [
    {
      "name": "Cloud Platform Enterprise Seats",
      "sku": "SKU-CLD-ENT-01",
      "quantity": 2,
      "unitPrice": 50000,
      "discount": 10,
      "description": "Enterprise tier licensing with 10% volume discount"
    },
    {
      "name": "Dedicated Solution Architect Support",
      "sku": "SKU-SRV-ARCH-01",
      "quantity": 1,
      "unitPrice": 90000,
      "discount": 0,
      "description": "Extended 9 months architecture advisory"
    }
  ],
  "tags": [
    "enterprise",
    "cloud-migration",
    "phase-1-2",
    "q4-target"
  ],
  "priority": "CRITICAL"
}

### 9. Progress Deal Stage
PATCH {{baseUrl}}/deals/{{dealId}}/stage
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "stage": "DEMO_MEETING",
  "probability": 45
}

### 10. Reassign Deal Owner
PATCH {{baseUrl}}/deals/{{dealId}}/owner
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "ownerId": "{{ownerId}}"
}

### 11A. Close Deal as WON
PATCH {{baseUrl}}/deals/{{dealId}}/close
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "stage": "CLOSED_WON"
}

### 11B. Close Deal as LOST (Mandatory lostReason)
PATCH {{baseUrl}}/deals/{{dealId}}/close
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "stage": "CLOSED_LOST",
  "lostReason": "Competitor offered 30% discount with aggressive multi-year contract terms.",
  "lostCompetitor": "Global Tech Competitor Ltd."
}

### 12. Reopen a Closed Deal
PATCH {{baseUrl}}/deals/{{dealId}}/reopen
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "reopenReason": "Client board allocated additional fiscal budget and reopened negotiations for Q1.",
  "targetStage": "NEGOTIATION",
  "probability": 80
}

### 13. Soft Delete Deal
DELETE {{baseUrl}}/deals/{{dealId}}
Authorization: Bearer {{authToken}}

### 14. Add Deal Note
POST {{baseUrl}}/deals/{{dealId}}/notes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "content": "Finance committee agreed on milestone-based payment terms: 40% advance, 30% mid-review, 30% sign-off."
}

### 15. Delete Deal Note
DELETE {{baseUrl}}/deals/{{dealId}}/notes/{{noteId}}
Authorization: Bearer {{authToken}}

### 16. Log CRM Activity (Meeting/Call/Email/Task)
POST {{baseUrl}}/deals/{{dealId}}/activities
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "type": "Meeting",
  "subject": "Executive Product Demo & Compliance Review",
  "description": "Reviewed enterprise SOC2 compliance, SSO integration, and user access roles with security team.",
  "activityDate": "2026-10-16T14:00:00.000Z",
  "durationMinutes": 60,
  "outcome": "Interested"
}

### 17. List Activity Timeline
GET {{baseUrl}}/deals/{{dealId}}/activities?page=1&limit=10
Authorization: Bearer {{authToken}}

### 18. Update Logged Activity
PATCH {{baseUrl}}/deals/{{dealId}}/activities/{{activityId}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "subject": "Executive Product Demo & Compliance Review (Completed with Next Steps)",
  "description": "Security team approved SSO and SOC2. Final proposal to be sent on Monday morning.",
  "activityDate": "2026-10-16T14:00:00.000Z",
  "durationMinutes": 75,
  "outcome": "Completed"
}

### 19. Delete Activity
DELETE {{baseUrl}}/deals/{{dealId}}/activities/{{activityId}}
Authorization: Bearer {{authToken}}
